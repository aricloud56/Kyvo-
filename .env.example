# KYVO environment. Copy to .env (or set in your host's dashboard). Never commit real values.

NODE_ENV=production
PORT=3000
# Public URL of the app, used for Stripe success/cancel/portal return links. No trailing slash.
APP_BASE_URL=https://app.example.com.au

# --- Database (PostgreSQL 14+; Supabase Postgres works) ---
# Runtime connection: the non-owner role "kyvo_app", so Row Level Security applies to every request.
DATABASE_URL=postgres://kyvo_app:CHANGE_ME@db.example.com:5432/postgres
# Owner/admin connection, used ONLY by the migrate, seed and make-admin commands. Never give it to the app server.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@db.example.com:5432/postgres
# "require" for hosted databases (Supabase needs it); omit for local.
DATABASE_SSL=require

SESSION_DAYS=30
# Sign-in/sign-up attempts per IP and per email per 15 minutes.
AUTH_RATE_LIMIT=10

# --- Stripe (start with TEST keys: sk_test_..., then switch to live after the checks in README) ---
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# Recurring AUD prices: A$9.99/month and A$79.99/year.
STRIPE_PRICE_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_ANNUAL=price_CHANGE_ME
# STRIPE_API_BASE=https://api.stripe.com   (tests point this at a local mock)

# --- Progress photo storage ---
# "local" stores files on disk under STORAGE_DIR (fine for one server with a persistent disk).
# "supabase" uses a PRIVATE Supabase Storage bucket (driver written but not yet verified against a real project).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
# SUPABASE_BUCKET=progress-photos

# --- TikTok pixel (optional; loads only on public pages after cookie consent) ---
# TIKTOK_PIXEL_ID=

# --- Tests only ---
# TEST_DATABASE_URL=postgres://kyvo_app:kyvo_app_dev@127.0.0.1:5433/kyvo_test
# TEST_DATABASE_ADMIN_URL=postgres://postgres:devpass@127.0.0.1:5433/kyvo_test
